{
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"outDir": "./dist",
		"rootDir": "./src/",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"lib": ["esnext"],
		"types": ["node"],
		"target": "ESNext",
		"moduleResolution": "NodeNext",
		"module": "NodeNext",
		"strict": false,
		"sourceMap": true,
		"esModuleInterop": true,
		"declaration": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
