{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@/*": ["./*"]
		},
		"lib": ["esnext"],
		"types": ["node"],
		"target": "ESNext",
		"moduleResolution": "NodeNext",
		"module": "NodeNext",
		"strict": false,
		"sourceMap": true,
		"esModuleInterop": true,
		"declaration": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
